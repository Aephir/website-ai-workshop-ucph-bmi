{
  "PostToolUse": [
    {
      "matcher": "Edit|Write",
      "hooks": [
        {
          "type": "command",
          "if": "Edit(*.md)|Write(*.md)",
          "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/phrase_sweep.py\""
        },
        {
          "type": "command",
          "if": "Edit(*claims-ledger.md)|Write(*claims-ledger.md)",
          "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_ledger_format.py\""
        }
      ]
    }
  ]
}
